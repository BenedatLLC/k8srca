      ],
      "text": "This is a microservice web-shop deployment whose components reach one another over addresses supplied as environment variables (for example CART_ADDR, PRODUCT_CATALOG_ADDR, KAFKA_ADDR)."
    },
    {
      "cites": [
        "derived:edges",
        "env:FRONTEND_HOST",
        "env:IMAGE_PROVIDER_HOST",
        "env:FLAGD_HOST",
        "env:FLAGD_UI_HOST",
        "env:LOCUST_WEB_HOST"
      ],
      "text": "All externally reachable traffic enters through frontend-proxy, which forwards to the frontend web application, the image-provider, the flagd feature-flag host and UI, and the load-generator web interface."
    },
    {
      "cites": [
        "derived:edges",
        "derived:callers",
        "env:LOCUST_HOST"
      ],
      "text": "The only declared traffic source inside the deployment is load-generator, which drives requests at frontend-proxy via LOCUST_HOST."
    },
    {
      "cites": [
        "derived:edges",
        "derived:callers"
      ],
      "text": "Order flow fans out from frontend to ad, cart, checkout, currency, product-catalog, recommendation and shipping; checkout in turn calls cart, currency, email, payment, product-catalog and shipping and publishes to kafka, which accounting and fraud-detection consume."
    },
    {
      "cites": [
        "derived:edges",
        "derived:callers",
        "env:DB_CONNECTION_STRING",
        "env:VALKEY_ADDR",
        "env:FLAGD_HOST"
      ],
      "text": "Persistent and keyed state lives in postgresql (used by accounting) and valkey-cart (used by cart); most services read feature flags from flagd."
    }
