# Copy to .env and fill in. .env is gitignored; never commit real values.

# --- Slack (orchestrator only; never reaches the sandbox -- design 001 §8) ---
# Basic Information -> App-Level Tokens, scope connections:write
SLACK_SOCKET_MODE_TOKEN=xapp-1-...
# OAuth & Permissions -> Bot User OAuth Token (after installing to the workspace)
SLACK_BOT_USER_OAUTH_TOKEN=xoxb-...
# Optional allowlist. Empty = respond in any channel the bot is invited to.
# Start with one channel while developing.
SLACK_ALLOWED_CHANNELS=
# Unused in Socket Mode (no inbound HTTP). Kept because Bolt may want it at init.
SLACK_SIGNING_SECRET=

# --- Anthropic ---
# Org-scoped. Orchestrator only: never set this on the poller host, where
# agent-authored bash could read it (design 001 §3.1).
ANTHROPIC_API_KEY=
# Console -> the self-hosted environment page -> Generate environment key.
# Poller and sandbox only.
ANTHROPIC_ENVIRONMENT_KEY=

# Scenario suite (design 004). A separate environment, so the production poller
# cannot claim scenario sessions and answer them from the live cluster.
ANTHROPIC_TEST_ENVIRONMENT_KEY=
K8SRCA_SCENARIO_ENVIRONMENT_ID=

# --- Local ---
# Console workspace ID, for building session deep links (design 003 §2.2).
K8SRCA_WORKSPACE_ID=

# How to reach the API server when it is not routable from a container -- an
# SSH tunnel, minikube, or kind. Leave unset if the kubeconfig's server is
# directly reachable. See docs/cluster-setup.md.
#   K8SRCA_SSH_HOST     ssh target, e.g. bastion.example.com
#   K8SRCA_SSH_REMOTE   API server as the ssh host sees it, e.g. 192.168.49.2:8443
K8SRCA_SSH_HOST=
K8SRCA_SSH_REMOTE=

# NOTE: the cluster credential is NOT set here. It lives in k8srca.yaml under
# cluster_access.kubeconfig, because `k8srca up` derives the container-side
# copy from it. See docs/cluster-setup.md.
